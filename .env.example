# Copie para .env.local e preencha. NÃO commite .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # segredo — só no servidor/Vercel

# Resend — sem domínio próprio, usar o remetente de teste onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM="Só Alegria <onboarding@resend.dev>"

# Upstash Redis (rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
